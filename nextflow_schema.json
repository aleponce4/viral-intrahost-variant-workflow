{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aleponce4/viral-intrahost-variant-workflow/main/nextflow_schema.json",
  "title": "viral-intrahost-variant-workflow pipeline parameters",
  "type": "object",
  "allOf": [
    {
      "if": { "properties": { "protocol": { "const": "amplicon" } } },
      "then": { "required": ["primer_bed"] }
    }
  ],
  "definitions": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "format": "file-path",
          "schema": "assets/schema_input.json",
          "description": "Path to comma-separated samplesheet with columns sample,fastq_1,fastq_2,treatment."
        },
        "fasta": {
          "type": "string",
          "format": "file-path",
          "description": "Path to viral reference FASTA file."
        },
        "gff": {
          "type": "string",
          "format": "file-path",
          "description": "Path to annotation GFF3 file containing CDS features."
        },
        "outdir": {
          "type": "string",
          "default": "./results",
          "description": "Output directory for workflow results."
        },
        "dataset": {
          "type": "string",
          "default": "viral_analysis",
          "description": "Dataset identifier used in reporting outputs."
        },
        "publish_dir_mode": {
          "type": "string",
          "default": "copy",
          "description": "Mode for publishing files to output directory (copy, symlink, link)."
        },
        "viral_contig": {
          "type": "string",
          "default": null,
          "description": "Target viral contig identifier in BAM files."
        }
      },
      "required": ["input", "fasta", "gff"]
    },
    "protocol_options": {
      "title": "Protocol options",
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "default": "metagenomic",
          "enum": ["metagenomic", "amplicon"],
          "description": "Sequencing protocol. 'amplicon' enables iVar primer trimming."
        },
        "primer_bed": {
          "type": "string",
          "format": "file-path",
          "description": "Primer BED file. Required when --protocol amplicon."
        }
      }
    },
    "ivar_options": {
      "title": "iVar parameters",
      "type": "object",
      "properties": {
        "ivar_min_depth": {
          "type": "integer",
          "default": 10,
          "description": "Minimum coverage depth threshold to examine positions for iVar variant calling."
        },
        "ivar_min_freq": {
          "type": "number",
          "default": 0.001,
          "description": "Minimum allele frequency to report, as a proportion (0–1). Values < 0.005 require median depth ≥ 10,000× to be statistically meaningful."
        },
        "ivar_min_bq": {
          "type": "integer",
          "default": 30,
          "description": "Minimum base quality for iVar."
        },
        "ivar_consensus_min_cov": {
          "type": "integer",
          "default": 10,
          "description": "Minimum coverage depth for consensus calling in iVar."
        },
        "ivar_consensus_threshold": {
          "type": "number",
          "default": 0.5,
          "description": "Allele frequency threshold for consensus nucleotide insertion."
        }
      }
    },
    "lofreq_options": {
      "title": "LoFreq parameters",
      "type": "object",
      "properties": {
        "lofreq_min_depth": {
          "type": "integer",
          "default": 10,
          "description": "Minimum coverage depth threshold for LoFreq calling."
        },
        "lofreq_min_bq": {
          "type": "integer",
          "default": 30,
          "description": "Minimum base quality for LoFreq."
        },
        "lofreq_min_mq": {
          "type": "integer",
          "default": 20,
          "description": "Minimum mapping quality for LoFreq."
        },
        "lofreq_sig": {
          "type": "number",
          "default": 0.01,
          "description": "Significance threshold for LoFreq variant call."
        },
        "lofreq_enable_indelqual": {
          "type": "boolean",
          "default": false,
          "description": "Enable indel quality assessment in LoFreq."
        },
        "lofreq_enable_baq": {
          "type": "boolean",
          "default": false,
          "description": "Enable base alignment quality calculation in LoFreq."
        }
      }
    },
    "haplotype_options": {
      "title": "Haplotype parameters",
      "type": "object",
      "properties": {
        "viloca_window": {
          "type": "integer",
          "default": 150,
          "description": "Window size for VILOCA/ShoRAH local quasispecies reconstruction."
        },
        "viloca_shift": {
          "type": "integer",
          "default": 50,
          "description": "Window shift step size for VILOCA/ShoRAH local quasispecies reconstruction."
        },
        "cliquesnv_min_freq": {
          "type": "number",
          "default": 0.001,
          "description": "Minimum allele frequency threshold for CliqueSNV quasispecies reconstruction."
        },
        "haplotype_report_min_freq": {
          "type": "number",
          "default": 0.01,
          "description": "Minimum frequency threshold (as a proportion 0–1) for reporting confirmed quasispecies haplotypes."
        },
        "viloca_min_pair_samples": {
          "type": "integer",
          "default": 2,
          "description": "Minimum sample threshold for classifying recurrent linked mutation pairs in VILOCA."
        },
        "viloca_min_pair_support": {
          "type": "number",
          "default": 0.80,
          "description": "Minimum posterior support threshold for VILOCA linked mutation pair reporting."
        },
        "viloca_min_reads": {
          "type": "number",
          "default": 10.0,
          "description": "Minimum read count threshold for VILOCA linked mutation pair reporting."
        }
      }
    },
    "workflow_toggles": {
      "title": "Workflow Stage Toggles",
      "type": "object",
      "properties": {
        "run_ivar": {
          "type": "boolean",
          "default": true,
          "description": "Enable iVar variant and consensus subworkflow."
        },
        "run_lofreq": {
          "type": "boolean",
          "default": true,
          "description": "Enable LoFreq variant calling subworkflow."
        },
        "run_annotation": {
          "type": "boolean",
          "default": true,
          "description": "Enable functional annotation via bcftools csq."
        },
        "run_coverage": {
          "type": "boolean",
          "default": true,
          "description": "Enable coverage depth summary and QC."
        },
        "run_snpgenie": {
          "type": "boolean",
          "default": false,
          "description": "Enable SNPGenie evolutionary selection subworkflow."
        },
        "run_haplotype": {
          "type": "boolean",
          "default": false,
          "description": "Enable CliqueSNV and VILOCA haplotype reconstruction."
        }
      }
    }
  },
  "properties": {
    "input": { "$ref": "#/definitions/input_output_options/properties/input" },
    "fasta": { "$ref": "#/definitions/input_output_options/properties/fasta" },
    "gff": { "$ref": "#/definitions/input_output_options/properties/gff" },
    "outdir": { "$ref": "#/definitions/input_output_options/properties/outdir" },
    "dataset": { "$ref": "#/definitions/input_output_options/properties/dataset" },
    "publish_dir_mode": { "$ref": "#/definitions/input_output_options/properties/publish_dir_mode" },
    "viral_contig": { "$ref": "#/definitions/input_output_options/properties/viral_contig" },
    "protocol": { "$ref": "#/definitions/protocol_options/properties/protocol" },
    "primer_bed": { "$ref": "#/definitions/protocol_options/properties/primer_bed" },
    "ivar_min_depth": { "$ref": "#/definitions/ivar_options/properties/ivar_min_depth" },
    "ivar_min_freq": { "$ref": "#/definitions/ivar_options/properties/ivar_min_freq" },
    "ivar_min_bq": { "$ref": "#/definitions/ivar_options/properties/ivar_min_bq" },
    "ivar_consensus_min_cov": { "$ref": "#/definitions/ivar_options/properties/ivar_consensus_min_cov" },
    "ivar_consensus_threshold": { "$ref": "#/definitions/ivar_options/properties/ivar_consensus_threshold" },
    "lofreq_min_depth": { "$ref": "#/definitions/lofreq_options/properties/lofreq_min_depth" },
    "lofreq_min_bq": { "$ref": "#/definitions/lofreq_options/properties/lofreq_min_bq" },
    "lofreq_min_mq": { "$ref": "#/definitions/lofreq_options/properties/lofreq_min_mq" },
    "lofreq_sig": { "$ref": "#/definitions/lofreq_options/properties/lofreq_sig" },
    "lofreq_enable_indelqual": { "$ref": "#/definitions/lofreq_options/properties/lofreq_enable_indelqual" },
    "lofreq_enable_baq": { "$ref": "#/definitions/lofreq_options/properties/lofreq_enable_baq" },
    "viloca_window": { "$ref": "#/definitions/haplotype_options/properties/viloca_window" },
    "viloca_shift": { "$ref": "#/definitions/haplotype_options/properties/viloca_shift" },
    "cliquesnv_min_freq": { "$ref": "#/definitions/haplotype_options/properties/cliquesnv_min_freq" },
    "haplotype_report_min_freq": { "$ref": "#/definitions/haplotype_options/properties/haplotype_report_min_freq" },
    "viloca_min_pair_samples": { "$ref": "#/definitions/haplotype_options/properties/viloca_min_pair_samples" },
    "viloca_min_pair_support": { "$ref": "#/definitions/haplotype_options/properties/viloca_min_pair_support" },
    "viloca_min_reads": { "$ref": "#/definitions/haplotype_options/properties/viloca_min_reads" },
    "run_ivar": { "$ref": "#/definitions/workflow_toggles/properties/run_ivar" },
    "run_lofreq": { "$ref": "#/definitions/workflow_toggles/properties/run_lofreq" },
    "run_annotation": { "$ref": "#/definitions/workflow_toggles/properties/run_annotation" },
    "run_coverage": { "$ref": "#/definitions/workflow_toggles/properties/run_coverage" },
    "run_snpgenie": { "$ref": "#/definitions/workflow_toggles/properties/run_snpgenie" },
    "run_haplotype": { "$ref": "#/definitions/workflow_toggles/properties/run_haplotype" }
  }
}
