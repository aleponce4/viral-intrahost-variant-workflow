nextflow_process {

    name "Test Process LOFREQ_FILTER"
    script "modules/local/lofreq/filter/main.nf"
    process "LOFREQ_FILTER"

    test("lofreq_filter - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.bam", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.vcf[0][1]).exists()
            assert path(process.out.qc_stats[0][1]).exists()
            assert path(process.out.versions[0]).exists()
        }

    }

    test("lofreq_filter - real") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.bam", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.vcf[0][1]).exists()
            assert path(process.out.vcf[0][2]).exists()
            assert path(process.out.qc_stats[0][1]).exists()
            assert path(process.out.versions[0]).exists()
        }

    }

}
