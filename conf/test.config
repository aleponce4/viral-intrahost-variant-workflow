/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test Profile Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset for pipeline verification'

    // Resource limits
    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'

    // Test inputs
    input = "${projectDir}/assets/samplesheet.test.csv"
    fasta = "${projectDir}/tests/data/viral_ref.test.fasta"
    gff   = "${projectDir}/tests/data/viral_ref.test.gff3"

    // Enable all optional branches in test profile
    run_ivar       = true
    run_lofreq     = true
    run_annotation = true
    run_coverage   = true
    run_snpgenie   = true
    run_haplotype  = true
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '1.h'
    ]
}
