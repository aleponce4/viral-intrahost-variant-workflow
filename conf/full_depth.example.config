/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Example resources for a full-depth run
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Measured on one stock library of about 47 million read pairs (about 1.2 million
    times coverage of an 11.4 kb genome) on a machine with 32 cores and 52 GB of RAM.

    Use it for the variant run only, because Stage A has processes with some of the same
    names:

        scripts/run_stock_workflow.sh ... --variants-config conf/full_depth.example.config

    Scale the numbers to your machine. They are not defaults.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process.resourceLimits = [ cpus: 16, memory: 48.GB, time: 48.h ]

process {
    // The default label gives LoFreq 4 threads. At this depth it ran 44 minutes on 16
    // (12.6 GB at its peak). That is with the default depth cap. With --lofreq_max_depth
    // 10000000, 16 threads passed 40 GB, and 8 threads peaked at 26 GB and ran for hours.
    // Lower cpus and raise memory if you raise the cap.
    withName: 'LOFREQ_CALL' {
        cpus   = 16
        memory = 16.GB
        time   = 24.h
    }

    // iVar is single-threaded and keeps the pileup it reads, so its memory grows with
    // progress: 30 GB at its peak, for 134 minutes. The default label asks for 8 GB, which
    // lets Nextflow run the two iVar passes side by side. Together they needed about 80 GB
    // of RAM plus swap here. Asking for what a pass needs makes Nextflow run them one after
    // the other. Better still, switch the consensus pass off: --run_ivar_consensus false
    withName: 'IVAR_VARIANTS|IVAR_CONSENSUS' {
        memory = 34.GB
        time   = 24.h
    }

    // 4.7 minutes on 12 threads.
    withName: 'BWA_MEM' {
        cpus = 12
        time = 12.h
    }

    // 4.4 minutes on 8 threads, 6.8 GB at its peak.
    withName: 'SAMTOOLS_SORT' {
        cpus   = 8
        memory = 10.GB
    }

    // One thread, 12.6 minutes, under 1 GB.
    withName: 'EXTRACT_VIRAL_BAM' {
        time = 24.h
    }
}
