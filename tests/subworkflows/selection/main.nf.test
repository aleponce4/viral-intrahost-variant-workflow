nextflow_workflow {

    name "Test Subworkflow SELECTION"
    script "subworkflows/selection/main.nf"
    workflow "SELECTION"

    test("selection - test") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id: 'viral_ref' ],
                    file("${projectDir}/tests/data/viral_ref.test.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/viral_ref.test.fasta.fai", checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id: 'viral_gff' ],
                    file("${projectDir}/tests/data/viral_ref.test.gff3", checkIfExists: true)
                ])
                input[3] = file("${projectDir}/assets/samplesheet.test.csv", checkIfExists: true)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.selection_tables != null
        }

    }

}
