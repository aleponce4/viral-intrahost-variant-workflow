/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Modules / Process Options & PublishDir Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: EXTRACT_VIRAL_BAM {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/BAMs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: LOFREQ_FILTER {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/LoFreq/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: IVAR_VARIANTS {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Ivar/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: IVAR_CONSENSUS {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Ivar/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: BCFTOOLS_CSQ {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Annotated_variants/${meta.caller ?: 'lofreq'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: COVERAGE_SUMMARIZE {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SNPGENIE_RUN {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/SNPGenie/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SELECTION_BUILD_TABLES {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/SNPGenie/analysis" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CLIQUESNV {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Haplotypes/CliqueSNV/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VILOCA {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Haplotypes/VILOCA/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: REPORT_RUN_SUMMARY {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Reports/tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REPORT_.*_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/${params.dataset}/Reports/Plots" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
