nextflow_process {

    name "Test Process LOFREQ_FILTER"
    script "modules/local/lofreq/filter/main.nf"
    process "LOFREQ_FILTER"

    test("lofreq_filter - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.bam", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.vcf[0][1]).exists()
            assert path(process.out.qc_stats[0][1]).exists()
            assert path(process.out.versions[0]).exists()
        }

    }

    test("lofreq_filter - real") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.bam", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.vcf[0][1]).exists()
            assert path(process.out.vcf[0][2]).exists()
            assert path(process.out.qc_stats[0][1]).exists()
            assert path(process.out.versions[0]).exists()
            // The default keeps LoFreq's own strand-bias rule.
            assert path(process.out.qc_stats[0][1]).text.contains("Strand-bias phred threshold: LoFreq built-in (FDR)")
        }

    }

    test("lofreq_filter - strand bias threshold is applied") {

        when {
            params {
                lofreq_sb_thresh = 60
            }
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.vcf[0][1]).exists()
            assert path(process.out.qc_stats[0][1]).text.contains("Strand-bias phred threshold: 60")
        }

    }

    test("lofreq_filter - 0 keeps LoFreq's built-in strand-bias rule") {

        when {
            params {
                lofreq_sb_thresh = 0
            }
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.vcf[0][1]).exists()
            assert path(process.out.qc_stats[0][1]).text.contains("Strand-bias phred threshold: LoFreq built-in (FDR)")
        }

    }

}
