nextflow_workflow {

    name "Test Subworkflow ANNOTATION"
    script "subworkflows/annotation/main.nf"
    workflow "ANNOTATION"

    test("annotation - test") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.ivar.tsv", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true),
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id: 'viral_ref' ],
                    file("${projectDir}/tests/data/viral_ref.test.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/viral_ref.test.fasta.fai", checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [ id: 'viral_gff' ],
                    file("${projectDir}/tests/data/viral_ref.test.gff3", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.annotated_vcf != null

            // The iVar fixture holds an SNV, a 1-base insertion in an AAAA run
            // (iVar reports it at the last A, position 203) and a 3-base deletion.
            def ivar = workflow.out.annotated_vcf.find { it[0].caller == 'ivar' }
            assert ivar != null
            def records = path(ivar[1]).readLines().findAll { !it.startsWith('#') }.collect { it.split('\t') }
            assert records.size() == 3

            // iVar's "+A" and "-CAG" must reach csq as valid VCF alleles.
            assert records.every { !(it[3] + it[4]).contains('+') && !(it[3] + it[4]).contains('-') }

            // The insertion is left-aligned to the base before the run, then annotated.
            def ins = records.find { it[1] == '199' }
            assert ins != null
            assert ins[3] == 'T' && ins[4] == 'TA'
            assert ins[7].contains('frameshift')

            // The 3-base deletion is in frame.
            def del = records.find { it[3] == 'ACAG' && it[4] == 'A' }
            assert del != null
            assert del[7].contains('inframe_deletion')

            // No liftover table, so no reference-coordinate VCF.
            assert workflow.out.refcoords_vcf.size() == 0
        }

    }

    test("annotation - liftover table adds reference coordinates") {

        when {
            params {
                // An identity map over the first 400 bases, enough to cover every fixture call.
                liftover_tsv = "${workDir}/identity.liftover.tsv"
            }
            workflow {
                """
                def rows = (1..400).collect { "KP282671.1\\t\${it}\\tKP282671.1\\t\${it}\\tmatch\\t.\\t." }
                new File(params.liftover_tsv).text =
                    "stock_contig\\tstock_pos\\tref_contig\\tref_pos\\tstatus\\tstock_base\\tref_base\\n" + rows.join("\\n") + "\\n"

                input[0] = Channel.of([
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.ivar.tsv", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true),
                    file("${projectDir}/tests/data/sampleA.test.vcf", checkIfExists: true)
                ])
                input[2] = Channel.of([
                    [ id: 'viral_ref' ],
                    file("${projectDir}/tests/data/viral_ref.test.fasta", checkIfExists: true),
                    file("${projectDir}/tests/data/viral_ref.test.fasta.fai", checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [ id: 'viral_gff' ],
                    file("${projectDir}/tests/data/viral_ref.test.gff3", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert workflow.success
            def ivar = workflow.out.refcoords_vcf.find { it[0].caller == 'ivar' }
            assert ivar != null
            def records = path(ivar[1]).readLines().findAll { !it.startsWith('#') }.collect { it.split('\t') }
            assert records.size() == 3
            // The map is the identity, so every call lands on its own position.
            assert records.every { it[7].matches(".*REF_POS=${it[1]}(;.*)?") }
            assert records.every { it[7].contains("REF_CONTIG=KP282671.1") }
        }

    }

}
