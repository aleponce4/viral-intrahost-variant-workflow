nextflow_process {
    name "Test Process FASTQC"
    script "modules/local/fastqc/main.nf"
    process "FASTQC"

    test("Should run FASTQC on paired FASTQ files") {
        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test_1.fastq.gz", checkIfExists: true),
                    file("${projectDir}/tests/data/sampleA.test_2.fastq.gz", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success
            assert process.out.html != null
            assert process.out.zip != null
            assert process.out.versions != null
        }
    }
}
