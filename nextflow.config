/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    alphavirus-variant-analysis Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow.enable.dsl = 2

plugins {
    id 'nf-schema@2.1.1'
}

// Global Default Parameters
params {
    // Input/output options
    input                      = null
    fasta                      = null
    gff                        = null
    outdir                     = './results'
    dataset                    = 'viral_analysis'
    publish_dir_mode           = 'copy'
    protocol                   = 'metagenomic'
    primer_bed                 = null

    // Reference & Target Contig
    viral_contig               = null

    // Stock reference construction (-entry BUILD_STOCK_REFERENCE)
    // De novo consensus for one virus stock, and the name its contig takes.
    stock_consensus            = null
    stock_name                 = null
    // Primer scheme in lab-reference coordinates. Moved onto the stock, because
    // ivar trim needs the coordinates of whatever the reads were aligned to.
    stock_primer_bed           = null
    // Table from BUILD_STOCK_REFERENCE (qc/<stock>.liftover.tsv). When set, the
    // annotated VCFs and the variant summary table gain lab-reference coordinates.
    liftover_tsv               = null

    // iVar parameters
    ivar_min_depth             = 10
    ivar_min_freq              = 0.001
    ivar_min_bq                = 30
    // Must match lofreq_min_mq. iVar's mpileup previously had no MAPQ floor
    // at all, so iVar and LoFreq were given different reads and their call
    // sets were not comparable.
    ivar_min_mq                = 20
    ivar_consensus_min_cov     = 10
    ivar_consensus_threshold   = 0.5

    // LoFreq parameters
    lofreq_min_depth           = 10
    lofreq_min_bq              = 30
    lofreq_min_mq              = 20
    lofreq_sig                 = 0.01
    lofreq_enable_indelqual    = false
    lofreq_enable_baq          = false
    // Strand-bias rule for `lofreq filter`. 0 (the default) keeps LoFreq's
    // built-in FDR rule. A value above 0 is passed as --sb-thresh and replaces
    // that rule with a fixed phred cutoff. The phred value of a call grows with
    // depth, so one number does not mean the same thing at every depth. Either
    // rule also needs about 85% of a call's alt reads on one strand before it
    // drops the call. On the TC-83 stock data neither removed a single call.
    lofreq_sb_thresh           = 0
    // LoFreq stops counting reads at this depth. Above it, a call's VAF comes from a
    // subset of the reads and can read high. Measured at 4.4 million times: 1.8% at the
    // default cap, 0.56% with the cap raised, 0.5% from iVar. 1000000 is LoFreq's own
    // default. A higher cap costs run time and memory only where depth exceeds it, and
    // LOFREQ_DEPTH_CHECK flags the calls made above the cap.
    lofreq_max_depth           = 1000000

    // Haplotype parameters
    viloca_window              = 150
    viloca_shift               = 50
    cliquesnv_min_freq         = 0.001
    haplotype_report_min_freq  = 0.01
    viloca_min_pair_samples    = 2
    viloca_min_pair_support    = 0.80
    viloca_min_reads           = 10.0

    // Workflow stage toggles
    run_ivar                   = true
    // The iVar consensus is a second full pileup of the same BAM, and nothing downstream
    // reads it. At full depth it costs as much time and memory as the variant pass.
    run_ivar_consensus         = true
    run_lofreq                 = true
    run_annotation             = true
    run_coverage               = true
    run_snpgenie               = false
    run_haplotype              = false

    // Resource limits
    max_cpus                   = 16
    max_memory                 = '32.GB'
    max_time                   = '24.h'
}

// Load base config
includeConfig 'conf/base.config'

// Load modules config
includeConfig 'conf/modules.config'

// Load container pins
includeConfig 'conf/containers.config'

// Profiles
profiles {
    test {
        includeConfig 'conf/test.config'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
}

// Manifest
manifest {
    name            = 'viral-intrahost-variant-workflow'
    author          = 'Alejandro Ponce-Flores'
    homePage        = 'https://github.com/aleponce4/viral-intrahost-variant-workflow'
    description     = 'Containerized Nextflow DSL2 workflow for viral intra-host variant calling (iSNV), quasispecies haplotype reconstruction, and evolutionary selection analysis.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.3.0'
}

// Execution reporting
def trace_timestamp = new java.text.SimpleDateFormat("yyyy-MM-dd_HH-mm-ss").format(new java.util.Date())
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
    overwrite = true
}

// Function to limit resource requests based on maximum available
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            return obj
        }
    }
}
