nextflow_pipeline {

    name "Test End-to-End Pipeline"
    script "main.nf"

    test("e2e - full pipeline test") {

        when {
            params {
                input         = "${projectDir}/assets/samplesheet.test.csv"
                fasta         = "${projectDir}/tests/data/viral_ref.test.fasta"
                gff           = "${projectDir}/tests/data/viral_ref.test.gff3"
                outdir        = "${outputDir}"
                run_ivar      = true
                run_lofreq    = true
                run_annotation= true
                run_coverage  = true
                run_snpgenie  = true
                run_haplotype = true
            }
        }

        then {
            assert workflow.success
            assert path("${outputDir}/Reports/tables/consolidated_sample_summary.tsv").exists()
            assert path("${outputDir}/Reports/tables/variant_frequency_summary_pct.tsv").exists()

            // Verify generated PNG plots exist and are non-trivial size (>5KB)
            def densityPlot = path("${outputDir}/Reports/Plots/viral_analysis_variant_density.png")
            assert densityPlot.exists()
            assert densityPlot.toFile().length() > 5000

            def spectrumPlot = path("${outputDir}/Reports/Plots/viral_analysis_allele_frequency_spectrum.png")
            assert spectrumPlot.exists()
            assert spectrumPlot.toFile().length() > 5000
        }

    }

}
