nextflow_process {

    name "Test Process EXTRACT_VIRAL_BAM"
    script "modules/local/extract_viral_bam/main.nf"
    process "EXTRACT_VIRAL_BAM"

    test("extract_viral_bam - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.bam", checkIfExists: true),
                    file("${projectDir}/tests/data/sampleA.test.bam.bai", checkIfExists: true)
                ]
                input[1] = 'KP282671.1'
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("extract_viral_bam - real") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'sampleA' ],
                    file("${projectDir}/tests/data/sampleA.test.bam", checkIfExists: true),
                    file("${projectDir}/tests/data/sampleA.test.bam.bai", checkIfExists: true)
                ]
                input[1] = 'KP282671.1'
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.bam[0][1]).exists()
            assert path(process.out.bam[0][2]).exists()
            assert path(process.out.versions[0]).exists()
        }

    }

}
