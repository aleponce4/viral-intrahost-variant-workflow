nextflow_process {

    name "Test Process STOCK_LIFTOVER_BED"
    script "modules/local/stock/liftover_bed/main.nf"
    process "STOCK_LIFTOVER_BED"

    test("stock_liftover_bed - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'stock-test' ],
                    file("${projectDir}/tests/data/stock.liftover.test.tsv", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/tests/data/primers.test.bed", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.bed[0][1]).exists()
            assert path(process.out.report[0][1]).exists()
            assert path(process.out.versions[0]).exists()
        }

    }

    test("stock_liftover_bed - places a reference primer scheme on the stock") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'stock-test' ],
                    file("${projectDir}/tests/data/stock.liftover.test.tsv", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/tests/data/primers.test.bed", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def rows = path(process.out.bed[0][1]).readLines()
                .findAll { it.trim() }.collect { it.split('\t') }
            assert rows.size() == 4

            // The output must name the stock contig, or ivar trim finds no
            // primers at all and silently trims nothing.
            assert rows.every { it[0] == 'stock-test' }

            // Every primer in the fixture sits before the stock's first
            // difference, so the coordinates come across unchanged.
            assert rows.collect { it[1..3] } == [
                ['10', '30', 'primer_1_F'], ['120', '140', 'primer_1_R'],
                ['200', '220', 'primer_2_F'], ['280', '300', 'primer_2_R']
            ]
            // ivar trim reads the score and strand columns.
            assert rows[0][5] == '+' && rows[1][5] == '-'

            def report = path(process.out.report[0][1]).readLines()
            assert report.size() == 5
            assert report[1..-1].every { it.split('\t')[-1] == 'exact' }
        }

    }

}
